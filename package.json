{
  "name": "novel-agent",
  "version": "0.1.0",
  "private": true,
  "description": "NovelAgent - 可插拔的 AI 小说创作平台（monorepo 根）",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "dev": "pnpm --filter @novelagent/launcher dev",
    "db:migrate": "pnpm --filter @novelagent/application db:migrate",
    "db:generate": "pnpm --filter @novelagent/application db:generate",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write \"packages/**/src/**/*.{ts,vue}\" \"apps/**/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
