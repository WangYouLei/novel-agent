{
  "name": "@novelagent/web",
  "version": "0.1.0",
  "description": "Web 层：Nest.js 后端（HTTP + WebSocket 网关 + Cordis 宿主）与 Vue 3 前端",
  "main": "dist/server/main.js",
  "types": "dist/server/main.d.ts",
  "scripts": {
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "dev:client": "vite",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@novelagent/application": "workspace:*",
    "@novelagent/core": "workspace:*",
    "@novelagent/market-client": "workspace:*",
    "@novelagent/model-service": "workspace:*",
    "@novelagent/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cordis": "^3.18.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@vitejs/plugin-vue": "^5.1.4",
    "element-plus": "^2.8.8",
    "pinia": "^2.3.1",
    "socket.io-client": "^4.8.0",
    "vite": "^5.4.10",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  }
}
