{
  "name": "@novelagent/plugin-outline-generator",
  "version": "1.1.0",
  "description": "示例功能插件：根据一句话创意生成完整小说大纲",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup"
  },
  "novelagent": {
    "id": "outline-generator",
    "displayName": "大纲生成",
    "type": "feature",
    "description": "根据一句话创意生成完整小说大纲",
    "author": "novelagent",
    "dependencies": {
      "model-service": ">=1.0.0"
    },
    "optionalDependencies": {},
    "inputSchema": [
      {
        "key": "idea",
        "name": "创意描述",
        "type": "textarea",
        "required": true,
        "description": "一句话小说创意，如：废柴少年捡到会说话的戒指，走上逆袭之路"
      }
    ],
    "styleRequirement": {
      "mode": "prefer",
      "compatibleBuiltinStyles": ["xuanhuan", "dushi", "scifi"],
      "recommendedPackIds": [],
      "embeddedFallback": {
        "promptTemplate": "你是一位经验丰富的小说大纲策划师。请基于用户的创意，产出一个结构完整、节奏张弛有度的小说大纲。",
        "vocabPreferences": []
      }
    },
    "configSchema": [
      {
        "key": "chapterCount",
        "name": "章节数量",
        "type": "number",
        "default": 20,
        "min": 5,
        "max": 10
      },
      {
        "key": "plotTwistFrequency",
        "name": "剧情转折频率",
        "type": "string",
        "default": "medium",
        "enum": ["low", "medium", "high"]
      },
      {
        "key": "includeForeshadowing",
        "name": "包含伏笔设计",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "dependencies": {
    "@novelagent/core": "workspace:*",
    "@novelagent/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
